  "script": "indicator(\"Request Lower TF Invalid Symbol Tuple Ignore Capture\", overlay=True)\ninvalid_open, invalid_close = request.security_lower_tf(\n    \"BINANCE:PYNE_MISSING_SYMBOL\",\n    \"15\",\n    (\"open\", \"close\"),\n    ignore_invalid_symbol=True,\n)\nplot(invalid_open.size(), \"Invalid LTF Tuple Open Count\")\nplot(invalid_close.size(), \"Invalid LTF Tuple Close Count\")\nplot(invalid_open.first(default=-111), \"Invalid LTF Tuple Open First\")\nplot(invalid_close.first(default=-222), \"Invalid LTF Tuple Close First\")\nplot(invalid_open.last(default=-333), \"Invalid LTF Tuple Open Last\")\nplot(invalid_close.last(default=-444), \"Invalid LTF Tuple Close Last\")\nplot(invalid_open.sum(default=0), \"Invalid LTF Tuple Open Sum\")\nplot(invalid_close.sum(default=0), \"Invalid LTF Tuple Close Sum\")\nplot(invalid_open.size() == 0, \"Invalid LTF Tuple Open Is Empty\")\nplot(invalid_close.size() == 0, \"Invalid LTF Tuple Close Is Empty\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_invalid_symbol = input.string(\"BINANCE:PYNE_MISSING_SYMBOL\", \"Pyne capture: invalid symbol\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_size(array<float> arr) =>\n    not na(arr) ? array.size(arr) : 0\n_pyne_ltf_first(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, 0) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n_pyne_ltf_sum(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.sum(arr) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Invalid Symbol Tuple Ignore\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n\n[_invalid_open, _invalid_close] = request.security_lower_tf(_pyne_capture_invalid_symbol, \"15\", [open, close], ignore_invalid_symbol=true)\nplot(_pyne_capture_active ? _pyne_ltf_size(_invalid_open) : na, \"Invalid LTF Tuple Open Count\")\nplot(_pyne_capture_active ? _pyne_ltf_size(_invalid_close) : na, \"Invalid LTF Tuple Close Count\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_invalid_open, -111) : na, \"Invalid LTF Tuple Open First\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_invalid_close, -222) : na, \"Invalid LTF Tuple Close First\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_invalid_open, -333) : na, \"Invalid LTF Tuple Open Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_invalid_close, -444) : na, \"Invalid LTF Tuple Close Last\")\nplot(_pyne_capture_active ? _pyne_ltf_sum(_invalid_open, 0) : na, \"Invalid LTF Tuple Open Sum\")\nplot(_pyne_capture_active ? _pyne_ltf_sum(_invalid_close, 0) : na, \"Invalid LTF Tuple Close Sum\")\nplot(_pyne_capture_active ? (_pyne_ltf_size(_invalid_open) == 0 ? 1 : 0) : na, \"Invalid LTF Tuple Open Is Empty\")\nplot(_pyne_capture_active ? (_pyne_ltf_size(_invalid_close) == 0 ? 1 : 0) : na, \"Invalid LTF Tuple Close Is Empty\")\n",
