  "script": "indicator(\"Request Lower TF Helpers Capture\", overlay=True)\nltf_close = request.security_lower_tf(\"BTCUSDT\", \"30\", \"close\")\nltf_time, ltf_open, ltf_high, ltf_low, ltf_provider_close, ltf_volume = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"30\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n)\nplot(ltf_close.size(), \"LTF Helper Count\")\nplot(ltf_close.first(), \"LTF Helper First Close\")\nplot(ltf_close.get(1, default=-111), \"LTF Helper Second Close\")\nplot(ltf_close.get(2, default=-222), \"LTF Helper Missing Close\")\nplot(ltf_close.min(), \"LTF Helper Min Close\")\nplot(ltf_close.max(), \"LTF Helper Max Close\")\nplot(ltf_close.sum(), \"LTF Helper Sum Close\")\nplot(ltf_close.avg(), \"LTF Helper Avg Close\")\nplot(ltf_time.get(0), \"LTF Helper Time 0\")\nplot(ltf_open.get(0), \"LTF Helper Open 0\")\nplot(ltf_high.get(0), \"LTF Helper High 0\")\nplot(ltf_low.get(0), \"LTF Helper Low 0\")\nplot(ltf_provider_close.get(0), \"LTF Helper Provider Close 0\")\nplot(ltf_volume.get(0), \"LTF Helper Volume 0\")\nplot(ltf_time.get(1), \"LTF Helper Time 1\")\nplot(ltf_open.get(1), \"LTF Helper Open 1\")\nplot(ltf_high.get(1), \"LTF Helper High 1\")\nplot(ltf_low.get(1), \"LTF Helper Low 1\")\nplot(ltf_provider_close.get(1), \"LTF Helper Provider Close 1\")\nplot(ltf_volume.get(1), \"LTF Helper Volume 1\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_get(array<float> arr, int idx, float fallback) =>\n    array.size(arr) > idx ? array.get(arr, idx) : fallback\n_pyne_ltf_first(array<float> arr, float fallback) =>\n    array.size(arr) > 0 ? array.get(arr, 0) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Helpers\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_ltf_close = request.security_lower_tf(syminfo.tickerid, \"30\", close)\n[_ltf_time, _ltf_open, _ltf_high, _ltf_low, _ltf_provider_close, _ltf_volume] = request.security_lower_tf(syminfo.tickerid, \"30\", [time, open, high, low, close, volume])\nplot(_pyne_capture_active ? array.size(_ltf_close) : na, \"LTF Helper Count\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_ltf_close, na) : na, \"LTF Helper First Close\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 1, -111) : na, \"LTF Helper Second Close\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 2, -222) : na, \"LTF Helper Missing Close\")\nplot(_pyne_capture_active ? array.min(_ltf_close) : na, \"LTF Helper Min Close\")\nplot(_pyne_capture_active ? array.max(_ltf_close) : na, \"LTF Helper Max Close\")\nplot(_pyne_capture_active ? array.sum(_ltf_close) : na, \"LTF Helper Sum Close\")\nplot(_pyne_capture_active ? array.avg(_ltf_close) : na, \"LTF Helper Avg Close\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 0, na) : na, \"LTF Helper Time 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 0, na) : na, \"LTF Helper Open 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 0, na) : na, \"LTF Helper High 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 0, na) : na, \"LTF Helper Low 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_provider_close, 0, na) : na, \"LTF Helper Provider Close 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 0, na) : na, \"LTF Helper Volume 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 1, na) : na, \"LTF Helper Time 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 1, na) : na, \"LTF Helper Open 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 1, na) : na, \"LTF Helper High 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 1, na) : na, \"LTF Helper Low 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_provider_close, 1, na) : na, \"LTF Helper Provider Close 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 1, na) : na, \"LTF Helper Volume 1\")\n",
