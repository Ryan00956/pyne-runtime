  "script": "indicator(\"Request Lower TF Requested Context Capture\", overlay=True)\nctx_time, ctx_time_close, ctx_mult, ctx_intraday, ctx_daily = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"30\",\n    lambda ctx: (\n        ctx.time,\n        ctx.time_close,\n        ctx.timeframe_info.multiplier,\n        1 if ctx.timeframe_info.isintraday else 0,\n        1 if ctx.timeframe_info.isdaily else 0,\n    ),\n)\nltf_time, ltf_open, ltf_high, ltf_low, ltf_close, ltf_volume = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"30\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n)\nplot(ctx_time.size(), \"LTF Ctx Count\")\nplot(ctx_time.last(), \"LTF Ctx Time Last\")\nplot(ctx_time_close.last(), \"LTF Ctx Time Close Last\")\nplot(ctx_time_close.last() - ctx_time.last(), \"LTF Ctx Duration Last\")\nplot(ctx_mult.last(), \"LTF Ctx Mult Last\")\nplot(ctx_intraday.last(), \"LTF Ctx Intraday Last\")\nplot(ctx_daily.last(), \"LTF Ctx Daily Last\")\nplot(ltf_time.get(0), \"LTF Ctx Time 0\")\nplot(ltf_open.get(0), \"LTF Ctx Open 0\")\nplot(ltf_high.get(0), \"LTF Ctx High 0\")\nplot(ltf_low.get(0), \"LTF Ctx Low 0\")\nplot(ltf_close.get(0), \"LTF Ctx Close 0\")\nplot(ltf_volume.get(0), \"LTF Ctx Volume 0\")\nplot(ltf_time.get(1), \"LTF Ctx Time 1\")\nplot(ltf_open.get(1), \"LTF Ctx Open 1\")\nplot(ltf_high.get(1), \"LTF Ctx High 1\")\nplot(ltf_low.get(1), \"LTF Ctx Low 1\")\nplot(ltf_close.get(1), \"LTF Ctx Close 1\")\nplot(ltf_volume.get(1), \"LTF Ctx Volume 1\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_get(array<float> arr, int idx, float fallback) =>\n    array.size(arr) > idx ? array.get(arr, idx) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    array.size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Requested Context\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_ctx_time, _ctx_time_close, _ctx_mult, _ctx_intraday, _ctx_daily] = request.security_lower_tf(syminfo.tickerid, \"30\", [time / 1000, time_close / 1000, timeframe.multiplier, timeframe.isintraday ? 1 : 0, timeframe.isdaily ? 1 : 0])\n[_ltf_time, _ltf_open, _ltf_high, _ltf_low, _ltf_close, _ltf_volume] = request.security_lower_tf(syminfo.tickerid, \"30\", [time, open, high, low, close, volume])\nplot(_pyne_capture_active ? array.size(_ctx_time) : na, \"LTF Ctx Count\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ctx_time, na) : na, \"LTF Ctx Time Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ctx_time_close, na) : na, \"LTF Ctx Time Close Last\")\nplot(_pyne_capture_active ? (_pyne_ltf_last(_ctx_time_close, na) - _pyne_ltf_last(_ctx_time, na)) : na, \"LTF Ctx Duration Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ctx_mult, na) : na, \"LTF Ctx Mult Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ctx_intraday, na) : na, \"LTF Ctx Intraday Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ctx_daily, na) : na, \"LTF Ctx Daily Last\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 0, na) : na, \"LTF Ctx Time 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 0, na) : na, \"LTF Ctx Open 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 0, na) : na, \"LTF Ctx High 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 0, na) : na, \"LTF Ctx Low 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 0, na) : na, \"LTF Ctx Close 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 0, na) : na, \"LTF Ctx Volume 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 1, na) : na, \"LTF Ctx Time 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 1, na) : na, \"LTF Ctx Open 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 1, na) : na, \"LTF Ctx High 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 1, na) : na, \"LTF Ctx Low 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 1, na) : na, \"LTF Ctx Close 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 1, na) : na, \"LTF Ctx Volume 1\")\n",
