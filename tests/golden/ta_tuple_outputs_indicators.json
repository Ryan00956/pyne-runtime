  "script": "macd_line, macd_signal, macd_hist = ta.macd(close, 4, 8, 3)\nbb_mid, bb_upper, bb_lower = ta.bb(close, 5, 1.5)\nplus_di, minus_di, adx = ta.dmi(5, 4)\nplot(macd_line, \"MACD 4 8 Line\")\nplot(macd_signal, \"MACD 4 8 Signal\")\nbar(macd_hist, \"MACD 4 8 Hist\")\nplot(macd_line - macd_signal, \"MACD Line Minus Signal\")\nplot(bb_mid, \"BB 5 Mid\")\nplot(bb_upper, \"BB 5 Upper\")\nplot(bb_lower, \"BB 5 Lower\")\nplot(bb_upper - bb_lower, \"BB 5 Width\")\nplot((close - bb_mid) / (bb_upper - bb_lower), \"BB 5 Relative\")\nplot(plus_di, \"Plus DI 5\")\nplot(minus_di, \"Minus DI 5\")\nplot(adx, \"ADX 5 4\")\nplot(plus_di - minus_di, \"DI Spread 5\")\n",
